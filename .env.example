# ──────────────────────────────────────────────
#  PowerDial Environment Variables
#  Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# Twilio Credentials
# Get these from console.twilio.com → Account → API keys
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio phone number (the caller ID leads will see)
# Buy one at console.twilio.com → Phone Numbers → Buy a number
TWILIO_PHONE_NUMBER=+18455550000

# Your personal phone number (PowerDial will call this when a lead answers)
# This is how you actually talk to the lead
AGENT_PHONE_NUMBER=+19145550000

# Public URL where this server is reachable by Twilio webhooks
# For local dev: use ngrok → ngrok http 3001 → copy the https URL
# For production: your Railway/Render/Fly.io URL
PUBLIC_URL=https://your-ngrok-id.ngrok.io

# Pre-recorded voicemail drop MP3 URL
# Record a 20-30 second VM message, upload to S3 or similar, paste URL here
# If blank, a TTS fallback message is used
VOICEMAIL_URL=

# Server port (default: 3001)
PORT=3001
